<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroAchievementBingoGenerator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RetroAchievementBingoGenerator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RetroAchievementBingoGenerator">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

<StackPanel>
    <Grid RowSpacing="30">
       <Grid.RowDefinitions>
           <RowDefinition Height="*"></RowDefinition> 
           <RowDefinition Height="*"></RowDefinition>
       </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
               <RowDefinition Height="*"></RowDefinition>
               <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"></ColumnDefinition>
               <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <ScrollViewer Height="200" Grid.Row="0" Grid.Column="0">
                <TreeDataGrid  Source="{Binding GameSystemsSource}" />
            </ScrollViewer>

            <Grid Grid.Column="0" Grid.Row="1" >
                <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" Grid.Column="0">
                    <Label Target="apiKey" Content="API Key" />
                    <TextBox x:Name="apiKey" Text="{Binding ApiKey}" PasswordChar="*" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Command="{Binding GetGameSystemsCommand}" Grid.Column="1">Grab Game Systems</Button>
            </Grid>

            <ScrollViewer Height="200" Grid.Row="0" Grid.Column="1">
                <TreeDataGrid  Source="{Binding GamesSource}" />
            </ScrollViewer>
  
            <Grid Grid.Column="1" Grid.Row="1" >
                <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" Grid.Column="0">
                    <Label Target="gameSearch" Content="Filter by Name" />
                    <TextBox x:Name="gameSearch" Text="{Binding GameSearchText}" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Command="{Binding GetGamesCommand}" Grid.Column="1">Grab Games</Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
               <RowDefinition Height="*"></RowDefinition>
               <RowDefinition Height="*"></RowDefinition>
           </Grid.RowDefinitions> 

            <ScrollViewer Height="350"  Grid.Row="0">
                <TreeDataGrid  Source="{Binding AchievementsSource}"/>
            </ScrollViewer>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                   <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding GamesDropDown}"
                          SelectedItem="{Binding SelectedGame}"
                          Grid.Column="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>                            
                            <TextBlock Text="{Binding Text}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="4" Grid.Column="1">
                    <Label Target="achievementSearch" Content="Filter by Goal &amp; Tooltip" />
                    <TextBox x:Name="achievementSearch" Text="{Binding AchievementSearchText}"/>
                </StackPanel>
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Command="{Binding GetAchievementsCommand}" Grid.Column="2">Grab Achievements</Button>
                <CheckBox IsChecked="{Binding ExcludeGoalsBeyondCharacterLimit}" Grid.Column="3">Exclude goals longer than 60 characters</CheckBox>
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="OpenAdvancedJsonOptions" Grid.Column="4">Advanced Options</Button>   
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="GenerateJson" Grid.Column="5">Copy JSON to Clipboard</Button>    
            </Grid>
        </Grid>
    </Grid>
</StackPanel>

</Window>
